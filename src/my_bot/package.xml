<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_bot</name>
  <version>0.0.0</version>
  <description>TurtleBot3 A* path planning + Pure Pursuit driving with YOLOv8 emergency stop</description>
  <maintainer email="ggori@todo.todo">ggori</maintainer>
  <license>TODO: License declaration</license>

  <!-- integrated_navigation 노드 -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_python</depend>

  <!-- 실제 로봇용 런치 파일 (SLAM, 위치 추정, RViz) -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>turtlebot3_cartographer</exec_depend>
  <exec_depend>turtlebot3_navigation2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
